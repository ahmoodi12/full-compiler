compiler = clang++

compilerFlags = -std=c++20 -g -O0 -Wall -Wextra -DDEBUG

rule compile
  command = $compiler $compilerFlags -c $in -o $out
  description = Compiling (debug) $in

rule link
  command = $compiler $in -o $out -g -O0
  description = Linking $out

build main.o: compile ../../src/main.cpp
build utils.o: compile ../../src/utils.cpp

build main.exe: link main.o utils.o
