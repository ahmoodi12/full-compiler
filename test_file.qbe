export
function w $main() {
@start.1
	%.1 =l alloc4 4
	%.2 =l alloc4 4
	%.3 =l alloc4 4
@body.2
	storew 67, %.1
	storew 76, %.2
	%.4 =w loadw %.1
	%.5 =w loadw %.2
	%.6 =w loadw %.2
	%.7 =w loadw %.1
	%.8 =w loadw %.2
	%.9 =w sub %.7, %.8
	%.10 =w mul %.6, %.9
	%.11 =w sub %.5, %.10
	%.12 =w add %.4, %.11
	storew %.12, %.3
	%.13 =w loadw %.1
	%.14 =w loadw %.3
	%.15 =w csgtw %.13, %.14
	jnz %.15, @if_true.3, @if_false.4
@if_true.3
@while_cond.5
	jnz 1, @while_body.6, @while_join.7
@while_body.6
	jmp @while_join.7
@while_join.7
	jmp @if_join.8
@if_false.4
	storew 5, %.2
@if_join.8
	ret 0
}
