{
  "rules": {
    "17": ["whitespace", "[ \\t\\n\\r]+", true],
    "18": ["multi line comment", "\\/\\*([\\s\\S]*?)\\*\\/", true],
    "19": ["single line comment", "\\/\\/[^\\n]*", true],
    "20": ["if", "if", false],
    "21": ["else", "else", false],
    "22": ["while", "while", false],
    "23": ["for", "for", false],
    "24": ["return", "return", false],
    "25": ["break", "break", false],
    "26": ["continue", "continue", false],
    "32": ["identifier", "[a-zA-Z_][a-zA-Z0-9_]*", false],
    "33": ["int_literal", "[0-9]+", false],
    "34": ["float_literal", "[0-9]+\\.[0-9]+", false],
    "35": ["string_literal", "\\\"(\\\\.|[^\\\"])*\\\"", false],
    "36": ["char_literal", "\\'(\\\\.|[^\\'])\\'", false],
    "37": ["==", "==", false],
    "38": ["!=", "!=", false],
    "39": ["<=", "<=", false],
    "40": [">=", ">=", false],
    "41": ["<", "<", false],
    "42": [">", ">", false],
    "43": ["=", "=", false],
    "44": ["+", "\\+", false],
    "45": ["-", "-", false],
    "46": ["*", "\\*", false],
    "47": ["/", "/", false],
    "48": ["%", "%", false],
    "49": ["(", "\\(", false],
    "50": [")", "\\)", false],
    "51": ["{", "\\{", false],
    "52": ["}", "\\}", false],
    "53": [";", ";", false],
    "54": [":", ":", false],
    "55": [",", ",", false],
    "56": ["?", "\\?", false],
    "100": ["EOF", "\\0", false]
  }
}