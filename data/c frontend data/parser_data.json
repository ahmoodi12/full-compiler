{
  "pratt parser": {
    "prefix binding power": 100,

    "expr data": {
      "(": {
        "types": ["opening wrapper"]
      },
      ")": {
        "types": ["closing wrapper"]
      },
      "+": {
        "lbp": 10,
        "rbp": 11,

        "types": [
          "prefix",
          "infix"
        ]
      },

      "-": {
        "lbp": 10,
        "rbp": 11,

        "types": [
          "prefix",
          "infix"
        ]
      },

      "*": {
        "lbp": 20,
        "rbp": 21,

        "types": [
          "prefix",
          "infix"
        ]
      },
      
      "/": {
        "lbp": 20,
        "rbp": 21,

        "types": [
          "infix"
        ]
      },
      "identifier": {
        "types": ["value"]
      },
      "int_literal": {
        "types": ["value"]
      },
      ";": {
        "types": ["expr terminator"]
      },
      ",": {
        "types": ["expr terminator"]
      }
    }
  }
}

