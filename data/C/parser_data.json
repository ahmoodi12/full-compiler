{
  "prefix binding power": 100,

  "expr definition": {
    "(": {
      "types": ["opening wrapper"]
    },
    ")": {
      "types": ["closing wrapper"]
    },
    "+": {
      "lbp": 10,
      "rbp": 11,

      "types": [
        "prefix",
        "infix"
      ]
    },

    "-": {
      "lbp": 10,
      "rbp": 11,

      "types": [
        "prefix",
        "infix"
      ]
    },

    "*": {
      "lbp": 20,
      "rbp": 21,

      "types": [
        "prefix",
        "infix"
      ]
    },
    
    "/": {
      "lbp": 20,
      "rbp": 21,

      "types": [
        "infix"
      ]
    },

    "!=": {
      "lbp": 20,
      "rbp": 21,

      "types": [
        "infix"
      ]
    },

    "?": {
      "types": [
        "ternary"
      ]
    },
    ":": {
      "types": [
        "ternary seperator"
      ]
    },

    "identifier": {
      "types": ["value"]
    },
    "int_literal": {
      "types": ["value"]
    },
    ";": {
      "types": ["expr terminator"]
    },
    ",": {
      "types": ["argument seperator"]
    }
  },

  "grammar": {
    "variables": {
      "#block": {
        "pattern": [["{", "__statements__", "}"]]
      }
    },

  "statement rules": {
    "if_stmt": { "pattern": [["if", "(", "__expr__", ")", "#block"], { "optional": ["else", "#block"] }] },
    
    "while_stmt": { "pattern": [["while", "(", "__expr__", ")", "#block"]] },
    
    "return_stmt": { "pattern": [["return"], { "optional": ["__expr__"] }, [";"]] },
    
    "assignment": { "pattern": [["identifier", "=", "__expr__", ";"]] },
    
    "declaration": { "pattern": [["identifier", "identifier"], { "optional": ["=", "__expr__"] }, [";"]] },
    
    "function": { "pattern": [["identifier", "identifier", "(", "_exprs", ")", "#block"]] },
    
    "expression": { "pattern": [["__expr__", ";"]] }
    }
  }
}

