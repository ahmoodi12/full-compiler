{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake",
      "type": "shell",
      "command": "cmake -S . -B build/test -G Ninja -DCMAKE_BUILD_TYPE=Debug"
    },
    {
      "label": "compile",
      "type": "shell",
      "command": "cmake --build build/test"
    },
    {
      "label": "build tests",
      "dependsOn": [
        "cmake",
        "compile"
      ],
      "dependsOrder": "sequence"
    }
  ]
}